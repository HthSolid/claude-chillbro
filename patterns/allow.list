# claude-chillbro :: ALLOW list
# JavaScript regexes, one per line. # = comment. Empty lines ignored.
# Matched against each segment of a compound command (after splitting on && || ; |).
# ASK list is checked FIRST — if any segment matches ask, the whole command is asked.
# So you can safely write broad allow patterns here; the narrow ask patterns override.

# --- File inspection (read-only) ---
^ls(\s|$)
^ll(\s|$)
^la(\s|$)
^cat\s
^head(\s|$)
^tail(\s|$)
^less(\s|$)
^more(\s|$)
^wc(\s|$)
^file\s
^stat\s
^tree(\s|$)
^pwd(\s|$)
^realpath\s
^readlink\s
^du(\s|$)
^df(\s|$)
^basename\s
^dirname\s

# --- Search / read-only text manipulation ---
^grep(\s|$)
^egrep(\s|$)
^fgrep(\s|$)
^rg(\s|$)
^ag(\s|$)
^ack(\s|$)
^find(\s|$)
^locate(\s|$)
^which(\s|$)
^whereis(\s|$)
^type\s
^command\s+-v\s
^sort(\s|$)
^uniq(\s|$)
^cut(\s|$)
^tr(\s|$)
^paste(\s|$)
^join(\s|$)
^diff(\s|$)
^comm(\s|$)
^cmp(\s|$)
^sed\s
^awk\s
^jq(\s|$)

# --- Git read-only ---
^git\s+status(\s|$)
^git\s+log(\s|$)
^git\s+diff(\s|$)
^git\s+show(\s|$)
^git\s+blame(\s|$)
^git\s+branch(\s|$)
^git\s+remote(\s|$)
^git\s+config\s+(--get|--list|-l)
^git\s+ls-files(\s|$)
^git\s+ls-tree(\s|$)
^git\s+rev-parse(\s|$)
^git\s+rev-list(\s|$)
^git\s+reflog(\s|$)
^git\s+stash\s+(list|show)
^git\s+describe(\s|$)
^git\s+tag(\s|$)
^git\s+fetch(\s|$)
^git\s+merge-base(\s|$)
^git\s+grep(\s|$)
^git\s+show-ref(\s|$)
^git\s+symbolic-ref(\s|$)
^git\s+for-each-ref(\s|$)
^git\s+--version
^git\s+help

# --- Package managers (read-only) ---
^npm\s+(list|ls|view|search|outdated|info|root|prefix|config\s+get)
^npm\s+--version
^pnpm\s+(list|ls|why|outdated|info|root)
^pnpm\s+--version
^yarn\s+(list|why|info)
^yarn\s+--version
^pip\s+(list|show|freeze|index)
^pip3?\s+--version
^cargo\s+(tree|metadata|version|search|locate-project)
^cargo\s+--version
^go\s+(list|version|env|doc)
^bundle\s+(list|info|show)

# --- Package managers (install — local only; ASK list catches -g/--global) ---
^npm\s+(i|install|ci)(\s|$)
^pnpm\s+(i|install|add)(\s|$)
^yarn\s+(install|add)(\s|$)
^pip\s+install(\s|$)
^pip3\s+install(\s|$)

# --- Build / test / lint / typecheck (no deploy) ---
^npm\s+(test|t|run)(\s|$)
^pnpm\s+(test|t|lint|build|typecheck|check|run|dev|start)(\s|$)
^yarn\s+(test|lint|build|typecheck|check|run|dev|start)(\s|$)
^tsc(\s|$)
^cargo\s+(build|check|test|clippy|fmt|doc|run|bench)(\s|$)
^pytest(\s|$)
^python\s+-m\s+pytest
^python3?\s+-m\s+(unittest|mypy|black|ruff|pip)
^go\s+(test|build|vet|fmt|run)(\s|$)
^make(\s|$)
^ruff(\s|$)
^eslint(\s|$)
^prettier(\s|$)
^biome(\s|$)
^vitest(\s|$)
^jest(\s|$)
^mypy(\s|$)
^black(\s|$)
^isort(\s|$)
^cmake(\s|$)
^ninja(\s|$)

# --- Process / system info ---
^ps(\s|$)
^top\s+-n\s+1
^htop(\s|$)
^btop(\s|$)
^uname(\s|$)
^hostname(\s|$)
^whoami(\s|$)
^id(\s|$)
^groups(\s|$)
^env(\s|$)
^printenv(\s|$)
^date(\s|$)
^uptime(\s|$)
^cal(\s|$)
^lscpu(\s|$)
^lsmem(\s|$)
^free(\s|$)
^lsblk(\s|$)

# --- Trivial / shell builtins ---
^echo(\s|$)
^printf\s
^clear(\s|$)
^reset(\s|$)
^true(\s|$)
^false(\s|$)
^test\s
^\[\s
^cd\s
^cd$
^pushd\s
^popd(\s|$)
# Shell control-flow keywords are always safe as segments (the actual
# commands they wrap are separately classified by the splitter).
^do(\s|$)
^done(\s|$)
^then(\s|$)
^fi(\s|$)
^else(\s|$)
^elif\s
^esac(\s|$)
^until\s
^while\s
^for\s
^select\s
^in(\s|$)
^case\s
# Sleep is just waiting; non-destructive.
^sleep\s+\d+(?:\.\d+)?\s*[smhd]?(\s|$)
# chmod +x / +X is just adding execute bit (idempotent). Broader chmod -R
# / 777 / +s are caught by the ASK list first.
^chmod\s+[ugoa]?\+[xX](\s|$)
# bash/sh syntax check (-n) doesn't execute, just parses.
^bash\s+-n\s
^sh\s+-n\s
^zsh\s+-n\s

# --- Shell environment / option toggles (local to shell, no exec) ---
# `set $(curl evil)` is blocked at the splitter level (subshell substitution
# bails to ask), so blanket allowing `set` and friends is safe.
^export(\s|$)
^unset(\s|$)
^set(\s|$)
^shopt(\s|$)
^alias(\s|$)
^unalias\s

# --- Filesystem create (idempotent or empty; out-of-cwd usually fails on perms) ---
^mkdir(\s|$)
^touch\s
^ln\s+-s\s

# --- Job control (shell-internal state, no new exec) ---
^disown(\s|$)
^wait(\s|$)
^jobs(\s|$)
^bg(\s|$)
^fg(\s|$)
^history(\s|$)

# --- Documentation lookup ---
^man(\s|$)
^whatis\s
^apropos\s
^info(\s|$)
^help(\s|$)

# --- Compressed-file inspection (read-only equivalents of cat/grep/less) ---
^zcat(\s|$)
^bzcat(\s|$)
^xzcat(\s|$)
^zless(\s|$)
^zgrep(\s|$)
^unzip\s+-l\s

# --- Archive listing (read-only). `tar` extract/create stays unknown so it
# escalates appropriately on the destructive forms.
^tar\s+(-t|--list)
^tar\s+-z?t[fvz]*\s

# --- Clipboard read ---
^pbpaste(\s|$)
^xclip\s+-o
^xsel\s+-o

# --- Hex / binary inspection ---
^xxd(\s|$)
^od(\s|$)
^hexdump(\s|$)
^strings(\s|$)

# --- Sourcing well-known shell init files (Rust, Node, shell rc, fzf, asdf,
# rbenv, sdkman). Generic `source <anything>` is intentionally NOT allowed —
# only this narrow set of paths users actually need at the start of a session.
# Both `source` and POSIX `.` forms; both `~/` and `$HOME/` paths; quoted or
# unquoted.
^(source|\.)\s+["']?(\$HOME|~)\/\.cargo\/env["']?(\s|$)
^(source|\.)\s+["']?(\$HOME|~)\/\.local\/share\/cargo\/env["']?(\s|$)
^(source|\.)\s+["']?(\$HOME|~)\/\.nvm\/nvm\.sh["']?(\s|$)
^(source|\.)\s+["']?(\$HOME|~)\/\.(bashrc|zshrc|profile|bash_profile|bash_aliases|zprofile|zshenv)["']?(\s|$)
^(source|\.)\s+["']?(\$HOME|~)\/\.fzf\.(bash|zsh)["']?(\s|$)
^(source|\.)\s+["']?(\$HOME|~)\/\.asdf\/asdf\.sh["']?(\s|$)
^(source|\.)\s+["']?(\$HOME|~)\/\.rbenv\/rbenv\.sh["']?(\s|$)
^(source|\.)\s+["']?(\$HOME|~)\/\.sdkman\/bin\/sdkman-init\.sh["']?(\s|$)
^(source|\.)\s+["']?(\$HOME|~)\/\.deno\/env["']?(\s|$)
^(source|\.)\s+["']?(\$HOME|~)\/\.bun\/_bun["']?(\s|$)

# --- Node syntax-check / build verification (read-only) ---
^node\s+--check\s
^node\s+-c\s
^npx\s+tsc(\s|$)
^npx\s+eslint(\s|$)
^npx\s+prettier(\s|$)
^npx\s+vitest(\s|$)
^npx\s+jest(\s|$)
^npx\s+esbuild\b[^|;&>]*--bundle=false
^npx\s+esbuild\b[^|;&>]*--check

# --- Prisma (read-only / idempotent subcommands only) ---
# Destructive forms (migrate reset, db push --accept-data-loss) caught by ASK.
^prisma\s+(generate|format|validate|version|--version)(\s|$)
^npx\s+prisma\s+(generate|format|validate|version|--version)(\s|$)

# --- SQLite read-only meta-commands ---
# ".tables", ".schema", ".databases" etc. don't modify the DB.
^sqlite3\s+\S+\s+["']?\.(tables|schema|databases|indexes|version|help|fullschema|width|show|stats)\b
^sqlite3\s+--version
^sqlite3\s+\.help

# --- gh read-only subcommands ---
# Mutations (gh pr merge, gh release create, gh issue close, etc.) are caught
# by the ask.list. These read-only forms cover the dominant non-prompted use
# (gh repo view, gh issue list, gh pr view, gh api GET requests).
^gh\s+(repo|pr|issue|release|run|workflow)\s+(view|list|status|diff|checks)(\s|$)
^gh\s+(repo|pr|issue|release|run)\s+(view|list)\s
^gh\s+api(\s|$)
^gh\s+search\s
^gh\s+auth\s+status
^gh\s+config\s+(get|list)
^gh\s+version(\s|$)
^gh\s+--version(\s|$)
^gh\s+browse(\s|$)
^gh\s+gist\s+(view|list)

# --- psql read-only invocations ---
# Only forms where the SQL passed to -c is clearly read-only (SELECT, SHOW,
# EXPLAIN, \dt, \l, \d etc.). Anything else (INSERT/UPDATE/DELETE/DO/TRUNCATE/
# DROP/ALTER/CREATE) keeps falling through to LLM/ask.
^psql\s.*-c\s+["']?\s*(SELECT|SHOW|EXPLAIN|VALUES|TABLE|WITH)\b
^psql\s.*-c\s+["']?\s*\\(dt|d|l|du|dn|df|dv|di|ds|dT|conninfo|copyright|encoding|errverbose|gexec|gset|prompt|set|setenv|sf|sv|timing|x|\?)\b
^psql\s.*-l(\s|$)
^psql\s.*--list(\s|$)
^psql\s.*-V(\s|$)
^psql\s.*--version

# --- Docker read-only ---
^docker\s+(ps|images|logs|inspect|version|info|stats|diff|history|port|top)(\s|$)
^docker\s+compose\s+(ps|logs|version|config|top)(\s|$)
^docker\s+image\s+(ls|inspect|history)
^docker\s+volume\s+(ls|inspect)
^docker\s+network\s+(ls|inspect)

# --- Network read-only ---
^ping\s+-c
^dig(\s|$)
^nslookup(\s|$)
^host\s
^curl\s+--head
^curl\s+-I(\s|$)
^wget\s+--spider

# --- Tool version / help wildcard ---
\s--version(\s|$)
\s--help(\s|$)

# --- v0.1.8 dev-loop coverage ---

# File copy/move: ASK list catches nothing destructive here at the verb level,
# but the OS still enforces perms (cp/mv into /etc fails) and write-classifier
# logic still gates the destination via the Write tool, not Bash.
^cp(\s|$)
^mv(\s|$)
^rsync(\s|$)
^ln\s+-sf?\s

# git read-only / control / non-destructive ops. The narrow destructive forms
# (push --force, reset --hard, branch -D, tag -d, rebase -i, checkout -- file,
# commit --amend, etc.) are already on ask.list and override these.
^git\s+checkout(\s+-b)?\s+\S+\s*$
^git\s+switch(\s+-c)?\s+\S+\s*$
^git\s+stash(\s+(push|pop|list|show|apply|drop|clear|save))?(\s|$)
^git\s+fetch(\s|$)
^git\s+tag(\s+(-l|--list|-a|--annotate|-s|--sign|-m\b))?
^git\s+rev-parse\s
^git\s+show(\s|$)
^git\s+diff(\s|$)
^git\s+cherry-pick\s+--(abort|continue|skip|quit)\s*$
^git\s+rebase\s+--(abort|continue|skip|quit|edit-todo|show-current-patch)\s*$
^git\s+reset\s+--soft\s
^git\s+reflog(\s|$)
^git\s+remote(\s+(-v|--verbose|show|get-url))?(\s|$)
^git\s+branch(\s+(-l|--list|--show-current|-a|--all|-r|--remotes|-v|--verbose|-vv|--contains|--no-contains))?\s*$
^git\s+merge-base\s
^git\s+blame\s
^git\s+grep\s
^git\s+describe(\s|$)
^git\s+name-rev\s
^git\s+ls-files(\s|$)
^git\s+ls-tree\s
^git\s+cat-file\s
^git\s+worktree\s+(list|add)(\s|$)
^git\s+config\s+(--get|--list|-l|--get-all)
^git\s+shortlog(\s|$)
^git\s+whatchanged(\s|$)

# gh read-only ops. release create / pr create / repo create are PUBLIC ops
# that warrant a confirmation, so they stay on the default ask flow.
^gh\s+(pr|issue|release|repo|workflow|run|gist|label|secret)\s+(view|list|status)(\s|$)
^gh\s+(pr|issue|release)\s+diff(\s|$)
^gh\s+(workflow|run)\s+(view|list|download)(\s|$)
^gh\s+api\s+(repos/[^ ]+(\s|$)|/[a-zA-Z0-9_/-]+(\s|$))

# chmod +x is the common dev-loop case (mark scripts executable). chmod -R
# (recursive), chmod 7XX/+s (world-executable), and any setuid/setgid mode
# (4XXX/2XXX/6XXX) stay on ask.list.
^chmod\s+\+x\s
^chmod\s+u\+x\s
^chmod\s+ugo\+x\s
^chmod\s+a\+x\s
^chmod\s+0?[0-6][0-7][0-7]\s+\S

# Python module / script run with -m. Inline scanner handles -c.
^python3?\s+-m\s
^python3?\s+\S+\.py(\s|$)

# Node/npm/pnpm/yarn read-only
^node\s+\S+\.[mc]?js(\s|$)
^node\s+\S+\.mjs(\s|$)
^node\s+test/
^node\s+tests/
^node\s+scripts/
^npm\s+(ls|list|root|prefix|view|info|outdated|audit|fund|why|search|exec\s+--help)
^npm\s+run\s+\S+(\s|$)
^pnpm\s+(ls|list|outdated|why|view|info|exec\s+--help)(\s|$)
^pnpm\s+(run\s+)?\S+(\s|$)
^yarn\s+(why|info|list|outdated)(\s|$)

# Running scripts in ./scripts/ or scripts/ (project-local). Compound check
# (ASK list catches dangerous things via segment patterns), but be cautious:
# we only auto-allow scripts in the project's own scripts/ dir.
^\./scripts/\S+
^scripts/\S+\.sh(\s|$)

# tail follow, head common forms, more variants
^tail\s+-[0-9nf]
^head\s+-[0-9n]

# Note: tar -cf and zip -r intentionally stay on ASK — they can write
# large files to arbitrary paths and smoke.mjs already covers that.

# Diff between files / hashing
^diff\s+
^cmp\s+
^sha(1|224|256|384|512)sum\s
^md5sum\s
